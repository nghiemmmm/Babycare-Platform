# syntax=docker/dockerfile:1.4

# ==============================================================================
# Build Arguments toàn cục
# Phiên bản CUDA Runtime và Model Version
# ==============================================================================
ARG CUDA_VERSION=12.1.1-runtime-ubuntu22.04
ARG MODEL_VERSION=v1.0.0

# ==============================================================================
# Stage 1: Builder (Cài đặt Python 3.11 & Torch CUDA 12.1)
# ==============================================================================
FROM nvidia/cuda:${CUDA_VERSION} AS builder
ARG MODEL_VERSION

WORKDIR /build

ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt Python 3.11 và các công cụ biên dịch C/C++ cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    build-essential \
    curl \
    libsndfile1-dev \
 && rm -rf /var/lib/apt/lists/*

# Tận dụng triệt để Layer Caching: copy requirements trước
COPY requirements.txt .

# Tạo virtualenv độc lập và cài đặt PyTorch hỗ trợ CUDA 12.1 cùng toàn bộ requirements
RUN python3.11 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121 \
 && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# Stage 2: Final Runtime (GPU Tối ưu & Siêu nhẹ)
# ==============================================================================
FROM nvidia/cuda:${CUDA_VERSION} AS runtime
ARG MODEL_VERSION

WORKDIR /app

# Khai báo Metadata Labels
LABEL maintainer="BabyCare AI Team"
LABEL ai.model.version="${MODEL_VERSION}"
LABEL ai.hardware="nvidia-gpu"

# Thiết lập biến môi trường tối ưu cho Python và NVIDIA Container Toolkit
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH" \
    MODEL_VERSION=${MODEL_VERSION} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PORT=8000 \
    HOST=0.0.0.0

# Cài đặt Python runtime và các thư viện xử lý âm thanh tiếng khóc & vector search
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    ffmpeg \
    libsndfile1 \
    libgomp1 \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Tạo dedicated non-root user và group để đảm bảo bảo mật an toàn
RUN groupadd -g 10001 appgroup \
 && useradd -u 10001 -g appgroup -s /bin/bash -m -d /home/appuser appuser \
 && mkdir -p /app /home/appuser/.cache \
 && chown -R appuser:appgroup /app /home/appuser

# Copy virtual environment từ builder stage
COPY --from=builder --chown=appuser:appgroup /opt/venv /opt/venv

# Copy toàn bộ mã nguồn dự án vào container và phân quyền cho appuser
COPY --chown=appuser:appgroup . /app

# Chuyển sang user không đặc quyền (non-root)
USER appuser

# Expose port backend
EXPOSE 8000

# Healthcheck định kỳ kiểm tra trạng thái dịch vụ FastAPI
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Khởi chạy ứng dụng FastAPI bằng Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
