# Firebase Configuration
# Path to the Firebase service account JSON key file (e.g. ./firebase-credentials.json)
FIREBASE_CREDENTIALS_PATH=D:/ViT/BABYCARE/babycare-ai/firebase-credentials.json

# Or raw JSON credentials string (alternative for production deployment)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Web API Key (KHÁC service account key) - dùng cho /auth/login và /auth/refresh
# (gọi Firebase Identity Toolkit REST API). Lấy tại Firebase Console > Project
# Settings > General > Web API Key.
FIREBASE_WEB_API_KEY=

# General FastAPI Configuration
APP_NAME="BabyCare AI"
APP_ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Redis (tùy chọn - để trống thì cache/rate-limit tự động fail-open sang bộ đếm trong
# bộ nhớ tiến trình)
# REDIS_URL=redis://localhost:6379/0
BABY_CACHE_TTL_SECONDS=60

# Timeout tối đa (giây) cho các call đồng bộ Firebase/Firestore chạy trong threadpool
THREADPOOL_TIMEOUT_SECONDS=10

# URL gốc của frontend - dùng làm giá trị tham chiếu cho các luồng auth cần link/redirect
FRONTEND_URL=http://localhost:5173

# SMTP (tùy chọn - để trống thì tính năng quên mật khẩu vẫn chạy nhưng không gửi được
# email thật, chỉ log warning). VD dùng Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=abc@gmail.com, SMTP_PASSWORD=<Gmail App Password, không phải mật khẩu thường>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Web Search - Out of Scope Handler
# Get your free API key at: https://app.tavily.com
# If not set, system falls back to DuckDuckGo (no key needed)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (tùy chọn - để trống thì ảnh đại diện bé/file ghi âm tiếng khóc tự
# fail-open sang lưu local app/static/). Lấy 3 giá trị tại Cloudinary Dashboard >
# Programmable Media > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
