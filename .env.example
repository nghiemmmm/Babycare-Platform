# Firebase Configuration
# Path to the Firebase service account JSON key file (e.g. ./firebase-credentials.json)
FIREBASE_CREDENTIALS_PATH=D:/ViT/BABYCARE/babycare-ai/firebase-credentials.json

# Or raw JSON credentials string (alternative for production deployment)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# General FastAPI Configuration
APP_NAME="BabyCare AI"
APP_ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Web Search - Out of Scope Handler
# Get your free API key at: https://app.tavily.com
# If not set, system falls back to DuckDuckGo (no key needed)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
