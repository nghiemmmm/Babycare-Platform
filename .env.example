# ==============================================================================
# BABYCARE AI - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Sao chép file này thành .env hoặc .env.development để bắt đầu phát triển:
#   cp .env.example .env
#
# LƯU Ý BẢO MẬT:
# - KHÔNG commit các file .env, .env.development, .env.production chứa secret thật vào Git.
# - Luôn sử dụng placeholders trong file template này.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="BabyCare AI"
APP_ENV=development                # "development" | "production" | "local"
DEBUG=true                         # Bắt buộc false trên production
LOG_LEVEL=info                     # "debug" | "info" | "warning" | "error"
PORT=8000
HOST=0.0.0.0
THREADPOOL_TIMEOUT_SECONDS=30
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & FIRESTORE DATABASE
# ------------------------------------------------------------------------------
# Đường dẫn tới file Service Account JSON (dành cho môi trường Local / Dev)
FIREBASE_CREDENTIALS_PATH=./baby-7d4a7-firebase-adminsdk-fbsvc-12ba4419bc.json

# Hoặc chuỗi JSON thô (phù hợp khi deploy lên Cloud / Docker Secrets / CI-CD)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Firebase Web API Key (dùng gọi Identity Toolkit REST API cho login/refresh token)
# Lấy tại: Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & STORAGE
# ------------------------------------------------------------------------------
# Nếu để trống, cache và rate limit sẽ tự động fallback sang bộ nhớ tiến trình (fail-open)
REDIS_URL=redis://localhost:6379/0
BABY_CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Danh sách IP hoặc dải mạng CIDR của Reverse Proxy được tin cậy (Nginx, Cloudflare, Docker Gateway)
RATE_LIMIT_TRUSTED_PROXIES=["127.0.0.1", "::1"]
RATE_LIMIT_DEFAULT_MAX_ATTEMPTS=10
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=600
RATE_LIMIT_VERIFY_OTP_MAX_ATTEMPTS=10
RATE_LIMIT_VERIFY_OTP_WINDOW_SECONDS=600
RATE_LIMIT_RESET_PASSWORD_MAX_ATTEMPTS=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=600

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL SERVICE (GỬI MÃ OTP QUÊN MẬT KHẨU)
# ------------------------------------------------------------------------------
# Nếu để trống, tính năng quên mật khẩu vẫn ghi nhận nhưng chỉ log warning, không gửi email thật
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME="BABY-CARE AI"

# ------------------------------------------------------------------------------
# 6. AI AGENTS & LLMOPS PROVIDERS
# ------------------------------------------------------------------------------
# Nhà cung cấp LLM chính: "openrouter" | "gemini" | "openai"
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-3.5-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# Khóa API (Điền khóa của nhà cung cấp bạn sử dụng)
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Tìm kiếm Web ngoài phạm vi (Tùy chọn - fallback DuckDuckGo nếu trống)
TAVILY_API_KEY=tvly-your-tavily-api-key

# LangSmith LLMOps Observability & Tracing (Tùy chọn)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=babycare-ai

# ------------------------------------------------------------------------------
# 7. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
# Tùy chọn: Nếu để trống, ảnh đại diện và file ghi âm tiếng khóc lưu local tại app/static/
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 8. PRE-START & HEALTH CHECK CONFIGURATION
# ------------------------------------------------------------------------------
PRE_START_MAX_TRIES=10
PRE_START_WAIT_SECONDS=3
