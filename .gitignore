# =============================================================================
# BabyCare AI — .gitignore
# Stack: FastAPI · LangGraph · PyTorch · React + Vite · Firebase
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────────────────────
venv/
ENV/
env/
.venv/

# Environment variables & Credentials (CRITICAL)
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example
*firebase-adminsdk*.json
firebase-credentials.json

# Python caching
__pycache__/
*.py[cod]
*$py.class

# Testing caching
.pytest_cache/
.coverage
htmlcov/

# Editor & IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# AI model weights (large binary, not for git — track separately / Git LFS if cần)
app/ai/CRY/weights/*.pth
app/ai/models/

# Runtime uploads (avatar bé, file ghi âm tiếng khóc) - fallback local khi Cloudinary
# chưa cấu hình/lỗi, xem app/infrastructure/storage/cloudinary_service.py
app/static/img/avatars/
app/static/cry/*.wav
app/static/cry/*.mp3
!app/static/cry/.gitkeep

CLAUDE.md