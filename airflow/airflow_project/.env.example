# ===========================================================================
# Cấu hình Môi trường cho Airflow & Ingestion Pipeline (SQLite Mode)
# ===========================================================================

# Database Configuration (SQLite)
DATABASE_URL=sqlite:////opt/airflow/data/rag_app.db
SQLITE_DB_PATH=/opt/airflow/data/rag_app.db

# Airflow Core Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.10
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__CORE__FERNET_KEY=46BKJoPlCSetupYourFernetKeyHere123456789=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session

# Airflow Admin User
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Ingestion Service
INGESTION_SERVICE_PORT=8000
UPLOAD_DIR=/opt/airflow/data/uploads
STORAGE_RAW_DIR=/opt/airflow/data/uploads
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
TRIGGER_DAG_NAME=ingest_documents_dag
